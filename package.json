{
  "name": "meal-planner",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Ateriasuunnittelija – local-first meal planner for Finnish recipes with Fineli nutrition estimates",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "start": "node server/index.ts",
    "preview": "npm run build && npm start",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "fineli:import": "node scripts/import-fineli.ts",
    "supplementary:list": "node scripts/import-supplementary.ts --list",
    "supplementary:build": "node scripts/import-supplementary.ts",
    "recipes:fetch": "node scripts/open-recipes/fetch-sources.ts",
    "recipes:normalize": "node scripts/open-recipes/normalize.ts",
    "recipes:build": "node scripts/open-recipes/build.ts",
    "recipes:batch": "node scripts/open-recipes/batch.ts"
  },
  "dependencies": {
    "dexie": "^4.4.6",
    "dexie-react-hooks": "^4.4.0",
    "lucide-react": "^1.49.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "fake-indexeddb": "^6.2.5",
    "fflate": "^0.8.3",
    "jsdom": "^30.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.3"
  }
}
